# Copy to backend/.env and fill in what you need. Everything has a working default
# for local development; the app runs without any AI key (rule-based fallback).

PORT=5000
NODE_ENV=development

# MongoDB. If this is unreachable in development, the server starts an in-memory
# MongoDB and seeds it automatically (data resets on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf
ALLOW_IN_MEMORY_DB=true
AUTO_SEED=true

# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS + Socket.IO).
CLIENT_URL=http://localhost:5173

# Shows the demo account list on the login page.
DEMO_MODE=true

# ---- AI ---------------------------------------------------------------
# auto   -> Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set
# gemini | openai -> force a provider
# none   -> rule-based fallback only
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hard timeout per AI call, and circuit breaker settings.
AI_TIMEOUT_MS=12000
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000
